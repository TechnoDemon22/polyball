# ---------------------------------------------------------------------------
# Polyball environment example. Copy to .env (root), .env in /client, or set
# these in your hosting provider. NEVER put secrets in VITE_* variables:
# everything prefixed with VITE_ is inlined into the public client bundle.
# ---------------------------------------------------------------------------

# --- Client (Vite) ---------------------------------------------------------
# WebSocket endpoint used by the browser. Leave empty to auto-detect
# (ws://<host>:8080 in dev, wss://<same-host> in production).
# Local development:
VITE_WS_URL=ws://localhost:8080
# Production example:
# VITE_WS_URL=wss://api.polyball.example.com

# Public site URL, used to build shareable /join/<CODE> links.
VITE_PUBLIC_URL=http://localhost:5173
# VITE_PUBLIC_URL=https://polyball.example.com

# Dev server port for Vite.
VITE_PORT=5173

# --- Server ----------------------------------------------------------------
# HTTP + WebSocket port for the authoritative game server.
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Comma separated list of allowed browser origins (CORS + WS origin check).
# Use "*" only for local development.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Serve the built client from the Node server (true/false).
SERVE_STATIC=false

# Trust X-Forwarded-For (enable when running behind a reverse proxy / CDN).
TRUST_PROXY=false
