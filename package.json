{
  "name": "polyball",
  "private": true,
  "version": "0.1.0",
  "description": "Polyball - a browser-only real-time multiplayer polygon Pong survival game",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @polyball/client",
    "dev:client": "npm run dev --workspace @polyball/client",
    "dev:server": "npm run dev --workspace @polyball/server",
    "dev:all": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "build": "npm run build --workspace @polyball/shared && npm run build --workspace @polyball/server && npm run build --workspace @polyball/client",
    "preview": "npm run preview --workspace @polyball/client",
    "start": "npm run start --workspace @polyball/server",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace @polyball/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md,html}\"",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "esbuild": "0.24.2",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "concurrently": "9.1.0",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "typescript-eslint": "8.18.2",
    "vitest": "2.1.8"
  }
}
